# fgc 미들웨어 이미지 (WAR + 외장 Tomcat). 1단계에서 소스를 빌드하고, 2단계에는 결과 WAR만 담는다.
#
#   podman build -f Containerfile.api -t localhost/fgc/api:v1 .
#   (Pod 안, 기본값)  podman run -d --pod fgc --name fgc-api localhost/fgc/api:v1
#   (따로 띄울 때)     podman run -d --name fgc-api -p 8082:8080 \
#                        -e SPRING_DATASOURCE_URL='jdbc:postgresql://host.containers.internal:5433/fgc?currentSchema=fgc' localhost/fgc/api:v1
#
# 이미지에는 특정 기계 주소를 박지 않는다. 기본값은 "같은 Pod 의 DB(localhost:5432)" 이고,
# Kubernetes 에서는 Service 이름을 -e 로 넘긴다 (ConfigMap/Secret). 로그의 기동 완료 줄: "Started ServletInitializer".

# ---------- 1단계: 빌드 ----------
FROM docker.io/library/eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY . .
# gradlew(Gradle 9.7)가 스스로 내려받는다. 테스트는 DB 컨테이너가 필요해 여기서 제외한다.
RUN chmod +x gradlew && ./gradlew bootWar -x test --no-daemon

# ---------- 2단계: 실행 ----------
# 태그를 고정한다 — "10.1-jre21" 은 날마다 다른 이미지라 스캔 결과가 재현되지 않는다 (교안: 리허설 후 Digest 고정)
FROM docker.io/library/tomcat:10.1.60-jre21
# base OS(Ubuntu) 패키지 CVE — 빌드 시점의 보안 패치 반영
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
 && rm -rf /usr/local/tomcat/webapps/*
COPY --from=build /src/build/libs/fgc-0.0.1-SNAPSHOT.war /usr/local/tomcat/webapps/ROOT.war

# 앞단 nginx 가 TLS 를 끝내고 X-Forwarded-Proto/For 를 넘긴다(nginx/default.conf.template). 외장 Tomcat 은
# application.yml 의 server.forward-headers-strategy(내장 Tomcat 전용)를 읽지 않으므로 같은 일을 RemoteIpValve 가 한다.
# 없으면 HTTPS 뒤에서 앱이 자기 출처를 http:// 로 알아 #400 토큰 API 의 Origin 검사가 전부 403 이 되고,
# 로그인 리다이렉트가 http:// 로 나가며, audit_log.client_ip 에 사용자 대신 nginx 주소가 남는다.
# 신뢰 프록시는 Tomcat 기본값(10/8·172.16/12·192.168/16·127/8 등 사설 대역) — 운영 prd-web→prd-was, Pod 내부 모두 해당.
# grep 은 Tomcat 이 server.xml 형식을 바꿔 sed 가 조용히 빗나가면 빌드를 실패시킨다.
RUN sed -i 's|<Engine name="Catalina" defaultHost="localhost">|&\n        <Valve className="org.apache.catalina.valves.RemoteIpValve" protocolHeader="X-Forwarded-Proto" portHeader="X-Forwarded-Port" />|' \
        /usr/local/tomcat/conf/server.xml \
 && grep -q 'portHeader="X-Forwarded-Port"' /usr/local/tomcat/conf/server.xml

# application-local.yml 은 .gitignore 라 이미지에 없다. 대신 환경변수로 같은 값을 준다.
ENV SPRING_DATASOURCE_URL="jdbc:postgresql://127.0.0.1:5432/fgc?currentSchema=fgc" \
    SPRING_DATASOURCE_USERNAME=fgc \
    SPRING_DATASOURCE_PASSWORD=fgc_local_only \
    SPRING_FLYWAY_LOCATIONS="classpath:db/migration,classpath:db/demo" \
    TZ=Asia/Seoul

EXPOSE 8080
CMD ["catalina.sh", "run"]
