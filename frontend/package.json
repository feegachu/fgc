{
  "name": "fgc-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:guide-features": "node scripts/guide-features.mjs --write",
    "check:guide-features": "node scripts/guide-features.mjs",
    "dev": "vite",
    "build": "npm run check:guides && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "test:e2e:stable": "node scripts/e2e-repeat.mjs",
    "test:e2e:negative": "node scripts/e2e-negative.mjs",
    "check:e2e": "tsc -p tsconfig.e2e.json",
    "generate:api": "openapi-typescript openapi/schema.json -o src/lib/api/schema.d.ts",
    "check:api": "node scripts/check-api.mjs",
    "check:guides": "node scripts/check-preview-guide.mjs && node scripts/check-guide-targets.mjs && node --test scripts/check-guide-targets.test.mjs && vitest run src/features/assistant/guide/ScreenHelp.test.tsx src/features/assistant/settlement/walkthrough-bindings.test.ts",
    "generate:guide-knowledge": "node scripts/workflow-knowledge.mjs --write",
    "check:guide-knowledge": "node scripts/workflow-knowledge.mjs"
  },
  "dependencies": {
    "@rive-app/react-canvas": "^4.38.0",
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
