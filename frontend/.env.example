# Internal assistant launcher: synthetic demo or read-only server Q&A. Both off by default.
VITE_ASSISTANT_DEMO=false
# Backend /api/v1/ai/pico/ask uses its server-side OPENAI_API_KEY; never put a key in VITE vars.
VITE_ASSISTANT_AI=false

# Deployment image: --build-arg VITE_ASSISTANT_AI=true (public boolean, never an API key).
# CI uses repository variable FGC_ASSISTANT_AI_ENABLED; default false. A fresh image build is required.
# Promoted dev/stage/Shinhan images retain the same compiled value; runtime env cannot toggle it.
