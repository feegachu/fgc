{
  "info": {
    "name": "FGC API",
    "description": "프런트, QA, 발표자가 API를 따로 확인하는 자산(FGC-PSR-003). 폴더 순서대로 실행합니다. 사용법은 docs/FGC_API_Postman_사용가이드_v1_0.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "contractId",
      "value": ""
    },
    {
      "key": "agentId",
      "value": ""
    },
    {
      "key": "commissionItemId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. 핵심 흐름 (순서대로)",
      "item": [
        {
          "name": "1. 로그인",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "X-FGC-Client",
                "value": "web"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Origin과 X-FGC-Client: web이 없으면 403입니다. 받은 accessToken을 컬렉션 변수에 넣습니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginId\": \"{{loginId}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. 내 정보",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "pm.test('역할이 있다', () => pm.expect(pm.response.json().data.roleCode).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. 계약 찾기",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/contracts?contractNo={{contractNo}}&page=1&size=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "contracts"
              ],
              "query": [
                {
                  "key": "contractNo",
                  "value": "{{contractNo}}"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "1"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "const row = pm.response.json().data.content[0];",
                  "pm.test('계약이 있다', () => pm.expect(row).to.be.an('object'));",
                  "pm.collectionVariables.set('contractId', row.contractId);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. 계약 상세",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/contracts/{{contractId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "contracts",
                "{{contractId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('agentId', pm.response.json().data.agentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. 수수료 항목",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/base/commission-items?asOf={{asOf}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "base",
                "commission-items"
              ],
              "query": [
                {
                  "key": "asOf",
                  "value": "{{asOf}}"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "const item = pm.response.json().data.find((i) => i.itemCode === 'BASE_COMMISSION');",
                  "pm.test('기본수수료 항목이 있다', () => pm.expect(item).to.be.an('object'));",
                  "pm.collectionVariables.set('commissionItemId', item.commissionItemId);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. 예상 스케줄",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/contracts/{{contractId}}/schedules?paymentStage=GA_TO_FC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "contracts",
                "{{contractId}}",
                "schedules"
              ],
              "query": [
                {
                  "key": "paymentStage",
                  "value": "GA_TO_FC"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "7. 지급 초안 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ]
            },
            "description": "10원짜리 초안을 만듭니다. 발표 서버에는 보내지 않습니다.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentStage\": \"GA_TO_FC\",\n  \"sourceType\": \"GA_MANUAL_PAYMENT\",\n  \"sourceBusinessKey\": \"POSTMAN-{{$timestamp}}\",\n  \"agentId\": \"{{agentId}}\",\n  \"contractId\": \"{{contractId}}\",\n  \"commissionItemId\": \"{{commissionItemId}}\",\n  \"settlementMonth\": \"{{month}}-01\",\n  \"scheduledPaymentDate\": \"{{payDate}}\",\n  \"amount\": 10,\n  \"cashflowType\": \"PAYMENT\",\n  \"attributions\": [\n    {\n      \"contractId\": \"{{contractId}}\",\n      \"amount\": 10,\n      \"attributionDate\": \"{{payDate}}\",\n      \"attributionMethod\": \"DIRECT\",\n      \"inclusionDecisionStatus\": \"INCLUDED\",\n      \"inclusionDecisionReason\": \"Postman 확인\",\n      \"exclusionType\": \"NONE\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 응답', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('transactionId', pm.response.json().data.commissionTransactionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "8. 사전검증",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/precheck",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transactionId}}",
                "precheck"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "pm.test('확정할 수 있다', () => pm.expect(pm.response.json().data.confirmable).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. 확정",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transactionId}}",
                "confirm"
              ]
            },
            "description": "같은 요청을 다시 보낼 때는 같은 Idempotency-Key를 써야 한 번만 처리됩니다.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "pm.test('확정 상태', () => pm.expect(pm.response.json().data.status).to.eql('CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "10. 월 통합검증 목록",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/validation-runs?page=1&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "validation-runs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "11. 예외 건수",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/exceptions/counts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "exceptions",
                "counts"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. 오류 예시",
      "item": [
        {
          "name": "토큰 없이 조회하면 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/contracts?page=1&size=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "contracts"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "1"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 응답', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "없는 계정으로 로그인하면 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "X-FGC-Client",
                "value": "web"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loginId\": \"postman-no-such-user\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 응답', () => pm.response.to.have.status(401));",
                  "pm.test('로그인 실패 코드', () => pm.expect(pm.response.json().error.code).to.eql('FGC-AUTH-001'));"
                ]
              }
            }
          ]
        },
        {
          "name": "필수값 없는 지급 등록은 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 응답', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "이미 확정한 지급을 다시 확정하면 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "{{transactionId}}",
                "confirm"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 응답', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. 마무리",
      "item": [
        {
          "name": "로그아웃",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{baseUrl}}"
              },
              {
                "key": "X-FGC-Client",
                "value": "web"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 응답', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.unset('accessToken');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}