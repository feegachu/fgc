# fgc 웹 tier (Nginx). 정적 파일은 여기서 직접 내주고, 나머지는 미들웨어(Tomcat)로 넘긴다.
# ${API_UPSTREAM} 은 컨테이너 시작 때 환경변수로 치환된다 (nginx 공식 이미지의 templates 기능).
#   같은 Pod 안:      API_UPSTREAM=127.0.0.1:8080  (기본값)
#   따로 띄웠을 때:   API_UPSTREAM=host.containers.internal:8082
# 브라우저가 본 포트(Host 헤더의 :포트, 없으면 scheme 기본값)를 Tomcat에 넘긴다.
# 컨테이너 안 $server_port(80)는 터널(18088)·발행 포트(8088)와 다르므로 쓰지 않는다.
map $scheme $fgc_scheme_port { https 443; default 80; }
map $http_host $fgc_forwarded_port { "~:(?<p>[0-9]+)$" $p; default $fgc_scheme_port; }
server {
    listen 80;
    server_name _;

    # 환경별 추가 설정(로그인 제한·actuator 차단·운영 TLS). deploy-host.sh가 넣는다. 없으면 아무 일도 없다(와일드카드 include).
    include /etc/nginx/fgc.d/*.conf;

    root /usr/share/nginx/html;

    # css·js·html 압축 전송 (woff2·jpg 는 이미 압축돼 있어 대상 아님)
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 정적 리소스: Nginx 가 직접 (Thymeleaf 화면이 /css /js ... 절대경로로 참조한다)
    location ~ ^/(css|js|images|fonts|assets)/ {
        expires 1h;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
    location = /favicon.ico {
        try_files $uri =404;
    }

    # React SPA (공존기 base /app/, #401). ^~ 라서 위 정규식 location 보다 먼저 잡힌다.
    location = /app {
        # 상대 Location 으로 보낸다. 절대 주소면 터널(8088)에서 :80 으로 튄다 ($http_host 주석과 같은 이유)
        absolute_redirect off;
        return 301 /app/$is_args$args;
    }
    # vite 산출물은 파일명에 해시가 있어 오래 캐시해도 된다. 없는 파일은 index.html 로 넘기지 않고 404.
    location ^~ /app/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    # 나머지 /app/* 는 클라이언트 라우트 → index.html. 배포 직후 옛 index.html 이 남지 않게 매번 재검증한다.
    location ^~ /app/ {
        add_header Cache-Control "no-cache";
        try_files $uri /app/index.html;
    }

    # 그 외 전부: 미들웨어로 프록시 (화면 렌더링 · /api · /login · /actuator)
    location / {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        # $http_host = 포트 포함 (예: localhost:8088). $host 는 포트를 떼서 리다이렉트가 :80 으로 튄다.
        proxy_set_header Host              $http_host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $http_host;
        proxy_set_header X-Forwarded-Port  $fgc_forwarded_port;
        proxy_read_timeout 60s;
    }
}
